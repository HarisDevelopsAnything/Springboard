# ===================================================================
# WellNest Backend - Environment Variables
# ===================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then run the app with:
#   export $(cat .env | xargs) && ./mvnw spring-boot:run
# ===================================================================

# JWT secret key (use a long random string in production)
JWT_SECRET=YourSuperSecretJWTKeyHere_ChangeThis

# Chat AES key (Base64 for 32-byte key; generate securely in production)
CHAT_AES_KEY=REPLACE_WITH_BASE64_AES_KEY_32_BYTES

# Gmail SMTP credentials (use a Google App Password, NOT your login password)
# See: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# OpenRouter AI Chat (called from backend)
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_STRICT_DOMAIN_FILTER=false
# Optional: override assistant behavior
# OPENROUTER_SYSTEM_PROMPT=You are WellNest AI coach...
